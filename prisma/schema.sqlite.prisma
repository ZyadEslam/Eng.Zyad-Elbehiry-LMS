// Prisma schema — SQLite for development. For production switch provider to "postgresql".
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  name         String
  passwordHash String
  role         String     @default("STUDENT") // ADMIN | STUDENT
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime?
  progress     Progress[]
  quizResults  QuizResult[]
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  sessionNum   Int
  lastSlide    Int      @default(0)
  maxSlide     Int      @default(0)
  totalSlides  Int      @default(0)
  completed    Boolean  @default(false)
  timeSpentSec Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, sessionNum])
}

model QuizResult {
  id         String   @id @default(cuid())
  userId     String
  sessionNum Int
  slideIndex Int
  correct    Boolean
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
