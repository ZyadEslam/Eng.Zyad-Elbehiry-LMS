{
  "name": "programming-ai-lms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node prisma/env.cjs next dev -H 0.0.0.0 -p 3001",
    "build": "node prisma/env.cjs prisma generate && node prisma/env.cjs prisma db push --accept-data-loss && next build",
    "start": "node prisma/env.cjs next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "db:push": "node prisma/env.cjs prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/env.cjs tsx prisma/seed.ts",
    "db:studio": "node prisma/env.cjs prisma studio",
    "postinstall": "prisma generate || true",
    "vercel-build": "node prisma/env.cjs prisma generate && node prisma/env.cjs prisma db push --accept-data-loss && next build",
    "db:seed:prod": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "node prisma/env.cjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "gsap": "^3.12.5",
    "jose": "^5.9.6",
    "lucide-react": "^1.47.0",
    "next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true
  }
}
